rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function activeAcademyUser(academyId) {
      return signedIn() &&
        profile().data.disabled != true &&
        profile().data.academyId == academyId;
    }

    function academyTeacher(academyId) {
      return activeAcademyUser(academyId) &&
        profile().data.role == 'teacher';
    }

    match /academies/{academyId}/songs/{songId}/{allPaths=**} {
      allow read: if activeAcademyUser(academyId);
      allow write: if academyTeacher(academyId);
    }
  }
}
